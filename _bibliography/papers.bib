@inproceedings{liao2022herb,
  abbr        = {IJCNN},
  bibtex_show = {true},
  title       = {Herb: Privacy-Preserving Random Forest with Partially Homomorphic Encryption},
  author      = {Liao, Qianying and Cabral, Bruno and Fernandes, João Paulo and Lourenço, Nuno},
  booktitle   = {2022 International Joint Conference on Neural Networks (IJCNN)},
  pages       = {1--10},
