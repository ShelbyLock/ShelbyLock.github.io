  month       = {July},
  publisher   = {IEEE},
  address     = {Padua, Italy},
  doi         = {10.1109/IJCNN55064.2022.9892321},
  html        = {https://ieeexplore.ieee.org/document/9892321/},
  abstract    = {We address private learning and inference for the Weighted Random Forest model when data records are vertically distributed among multiple sites. We contribute efficient collaborative algorithms for computing the impurity of decision tree nodes while protecting all intermediate values, a learning protocol based on the Paillier Cryptosystem and Digital Envelopes, and an inference protocol based on Look-up Tables.},
